@11359 = ~В вашем дневнике новая запись.~ [GAM_06]
@11360 = ~Карта мира обновлена.~
@11361 = ~[GAMESMAN 1]~ [GAMES01]
@11362 = ~Хесито~
@11363 = ~Тренировочный манекен~
@11364 = ~Хесито~
