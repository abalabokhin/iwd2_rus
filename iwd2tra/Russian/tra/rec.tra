@16165 = ~Вызов монстров VI
(Призывание) 
Уровень: бард 6, жрец 6, колдун/волшебник 6
Дальность: обзор колдующего
Длительность: 3 раунда + 1 раунд/уровень
Время чтения: 6
Зона действия: особая 
Спасбросок: нет 

Заклинание вызывает чудовище, которое будет сражаться на стороне колдующего, пока действует заклинание. Вид монстра определяется случайным образом. Заклинания более высокого уровня вызывают более мощных существ.~
@16166 = ~"Проклятые гвозди! Ну, теперь-то вам не до смеха?! НЕ ДО СМЕХА, ДА?!"~
@16167 = ~Иллиум Ар'Гренуар~
@16168 = ~Следопыт-аурилит~
@16169 = ~"Ой! Надеюсь, мне за это не попадёт..."~
@16170 = ~Вызов монстров VII
(Призывание) 
Уровень: священник 7, колдун/волшебник 7, жрец Темпуса 7
Дальность: обзор колдующего
Длительность: 3 раунда + 1 раунд/уровень
Время чтения: 6
Зона действия: особая 
Спасбросок: нет 

Заклинание вызывает чудовище, которое будет сражаться на стороне колдующего, пока действует заклинание. Вид монстра определяется случайным образом. Заклинания более высокого уровня вызывают более мощных существ.~
@16171 = ~"Я смотрю на этот щит всего лишь несколько часов..."~
@16172 = ~"Интересно, куда подевался капитан..."~
@16173 = ~"Вот, совсем как новенькая. Даже лучше!"~
@16174 = ~"Посмотрим, как гоблины проломятся сквозь это!"~
@16175 = ~"Эта штука прочна, словно камень! Папаша бы мной гордился."~
@16176 = ~"И как прикажете чинить *вот это*?"~
@16177 = ~Хулл~
@16178 = ~Флидия~
@16179 = ~Дреппин~
@16180 = ~Фуллер~
@16181 = ~Хротгар~
@16182 = ~Флидия~
@16183 = ~Фуллер~
@16184 = ~"Без брёвен стену не возведёшь, вот и весь сказ."~
@16185 = ~"Я инженер, а не фокусник!"~
@16186 = ~"Если гоблины нападут сейчас, нам крышка..."~
@16187 = ~"Где мои брёвна?"~
@16188 = ~"Что-то я не вижу тут никаких брёвен."~
@16189 = ~Информация о заклинании~
@16190 = ~Ты приходишь в себя и понимаешь, что это был не какой-то ужасный сон. Попав в засаду, Горайон был сражён на твоих глазах, и даже его могучая магия не смогла остановить это нападение. Он сам велел тебе бежать, но это не избавит от чувства беспомощности, которое переполняет тебя. 

"Отдай мне своё приёмное дитя", - сказал злодей в доспехах. Он пришёл за тобой и только за тобой, но почему? Если бы только Горайон мог дать хоть какую-нибудь подсказку, но теперь ты в одиночестве и растерянности. Кендлкип совсем рядом, но ты не найдёшь там укрытия. Чтецы оплачивают свою безмятежность довольно безжалостными правилами входа, и без влияния Горайона их двери останутся закрытыми.~ [CHAP00B]
