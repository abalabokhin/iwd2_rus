@21990 = ~Хурган Закаменевший Клинок~
@21991 = ~Наполненный кровью кубок~
@21992 = ~Солианна~
@21993 = ~Солианна~
@21994 = ~Кровь друга Квалло~
@21995 = ~Трацея Карол~
