@17884 = ~Этот истощённый узник, похоже, умер от голода. Судя по запаху, смерть наступила несколько дней назад.~
@17885 = ~"Послушай моего совета... уходи из Лютого Леса!"~
@17886 = ~"Лютый Лес - не самое приятное место..."~
@17887 = ~Наложено проклятие вялости.~
@17888 = ~"Как мне произвести впечатление на отца Ани?.."~
@17889 = ~"Так тихо... Так мирно."~
@17890 = ~"Ах! Это моя любимая полянка в лесу!"~
@17891 = ~"Как же хорошо, что смертные избегают заходить в эти леса."~
@17892 = ~"Эй! Хо! Посмотри на меня! Я кручусь!"~
@17893 = ~"Я кручусь!"~
@17894 = ~"Ох... Как-то мне плохо..."~
@17895 = ~Аура жизненной энергии~
@17896 = ~Вы привели кузню в рабочее состояние, и теперь неупокоенные души дварфов обретут мир.~
@17897 = ~Аура жизненной энергии
(Преобразование) 
Уровень: друид 7, жрец Латандера 8
Дальность: колдующий
Длительность: 1 раунд/уровень
Время чтения: 7
Зона действия: радиус 5 футов
Спасбросок: нет

При наложении этого заклинания заклинатель излучает магическую энергию, которая пропитывает всех находящихся поблизости союзников и увеличивает их живучесть. Это позволяет им выполнять физические действия, далеко выходящие за рамки обычных способностей. Все союзники в зоне действия получают +4 к Силе, Ловкости и Телосложению на время действия заклинания.~
