@18307 = ~"И кто они?"~
@18308 = ~"Защитите деревню!"~
@18309 = ~Постойте... Что-то пришло сюда... На деревню напала чёрная, страшная сила, и она ищет... она ищет *тебя*... Она там, у ворот...~ [SOUM027]
@18310 = ~"Сколько ты заплатил за рабов? Говорят, тебя надули."~
@18311 = ~"Кожа ротха... кишки аболета... всё одно и тоже. Никому это уже не интересно!"~
@18312 = ~"Проклятье! Здесь так холодно!"~
@18313 = ~Электрическая петля Гедли~
