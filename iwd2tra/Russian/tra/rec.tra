@19058 = ~[Voic2e:Тяжёлые раны] Если мне сейчас не помогут, я точно умру.~ [PC3MA11]
@19059 = ~[Voic2f:Selected 1] Что надо сделать?~ [PC3MA17]
@19060 = ~[Voic2g:Selected 2] Что прикажешь?~ [PC3MA18]
@19061 = ~[Voic3a:Battle Cry] Пора устроить хорошую драку!~ [PC4MA3]
@19062 = ~[Voic4a:Battle Cry] Все умрут!~ [PC4FE3]
@19063 = ~[Voic5a:Battle Cry] Я заберу твою жизнь!~ [PC5FE3]
@19064 = ~[Voic6a:Battle Cry] Встречай свою смерть!~ [VOIC6A]
@19065 = ~[Voic3b:Becoming Leader] Ха-ха! Я буду хорошим лидером!~ [PC4MA8]
@19066 = ~[Voic4b:Becoming Leader] Кроме меня никто не займёт это место.~ [PC4FE8]
@19067 = ~[Voic5b:Becoming Leader] Я заслуживаю места лидера.~ [PC5FE8]
@19068 = ~[Voic6b:Becoming Leader]~ [VOIC6B]
@19069 = ~[Voic3c:Tired] Скоро мне понадобится отдохнуть.~ [PC4MA9]
@19070 = ~[Voic4c:Tired] Я засну на ходу, если не отдохну.~ [PC4FE9]
@19071 = ~[Voic5c:Tired] Нам пора отдохнуть. Мне нужно поспать.~ [PC5FE9]
@19072 = ~[Voic6c:Tired]~ [VOIC6C]
@19073 = ~[Voic3d:Bored] Пойдём! Нельзя терять целый день.~ [PC4MA10]
@19074 = ~[Voic4d:Bored] Бездействие меня очень раздражает.~ [PC4FE10]
@19075 = ~[Voic5d:Bored] Как же скучно.~ [PC5FE10]
@19076 = ~[Voic6d:Bored]~ [VOIC6D]
@19077 = ~[Voic3e:Тяжёлые раны] Возможно, мои раны серьёзнее, чем мне казалось.~ [PC4MA11]
@19078 = ~[Voic4e:Тяжёлые раны] Кто-то срочно должен заняться моими ранами.~ [PC4FE11]
@19079 = ~[Voic5e:Тяжёлые раны] Меня... меня ранили.~ [PC5FE11]
@19080 = ~[Voic6e:Тяжёлые раны]~ [VOIC6E]
