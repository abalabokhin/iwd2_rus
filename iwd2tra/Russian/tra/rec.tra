@20582 = ~Конечно.~
@20583 = ~Уже иду.~
@20584 = ~Определённо.~
@20585 = ~Хорошо... Я тебе доверяю.~
@20586 = ~Дарёному коню в зубы не смотрят.~
@20587 = ~Медная монетка золотой бережёт.~
@20588 = ~Грифонов по осени считают.~
@20589 = ~Что? Что? ЧТО-О-О-О-О-О-О?~
@20590 = ~Ох-х!~
@20591 = ~А-а-а!~
