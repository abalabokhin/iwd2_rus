@16313 = ~[MAINGUI BUTTON]Возврат к игре~
@16314 = ~Ардруин~
@16315 = ~Ардруин~
@16316 = ~"Сначала ударь, а *затем* проверни копьё!"~
@16317 = ~"Не забывайте, эта бочка - гоблин! Вперёд!"~
@16318 = ~"Просто *представь*, что там бочка, понятно?"~
@16319 = ~"Я что, приказал остановиться? Если нет мишени, руби воздух!"~
