@39769 = ~"Добрый день."~
@39770 = ~"Добрый вечер."~
@39771 = ~"Не знаешь, почему верховная жрица Ория закутана плотнее, чем мумия на празднике любви некромантов? Она раскроила своим посохом череп какому-то шаману - и всё из-за того, что бедняга случайно задел её, проходя мимо."~
@39772 = ~"Какие-то наёмники из Лускана устраивают беспорядки в окрестностях: отсюда и до Таргоса. На самом деле все три сестры обеспокоены."~
@39773 = ~"До Таргоса? Святая Ледяная Заря! Ты же не имеешь ввиду тех бандитов с разбившегося летучего корабля?!"~
@39774 = ~"Их самых! Говорят, они все боги - или что-то вроде того. А ведёт их сам дьявол во плоти по имени <CHARNAME>."~
@39775 = ~"Их самых! Говорят, они все боги - или что-то вроде того. А ведёт их трёхногая распутная дьяволица по имени <CHARNAME>."~
@39776 = ~"Сколько же их? Они наверное ведут целую армию, раз зашли так далеко!"~
@39777 = ~"Нет, говорят, их только шестеро."~
@39778 = ~"Нет, говорят, их только пятеро."~
@39779 = ~"Нет, говорят, их только четверо."~
@39780 = ~"Нет, говорят, их только трое."~
@39781 = ~"Нет, говорят, их только двое."~
@39782 = ~"Нет, наёмник всего один... я говорю, *один*!"~
@39783 = ~"Погоди - госпожа Шеринкаль же сбросила одного из них со скалы у Андоры, так что, может, они и не очень грозные."~
@39784 = ~"Надеюсь, что так оно и есть."~
@39785 = ~"Этот ледник - последнее, что преграждает Западный Перевал. Мы не можем облажаться."~
@39786 = ~"ПРОКЛЯТЬЕ! Я сегодня в ударе!"~
@39787 = ~"Эй ты там, я никак не могу найти дорогу. Ты не знаешь, как пройти к предгорьям?"~
@39788 = ~"Да, мы только что оттуда. Приветствую. Я - <CHARNAME>. Кто..."~
@39789 = ~"<CHARNAME>?! Ты не очень-то спешишь, да? Натаниэль сказал, что ты спасёшь нас, но *Мастер замков* никого не ждёт!"~
@39790 = ~"Натаниэль?"~
@39791 = ~"Да, он сидит в тюрьме, на первом этаже ледяного храма - всё надеется, что ты его спасёшь. Постарайся не погибнуть, как те другие *герои*, ладно? М-м-м... Слушай, мне бы очень хотелось постоять ещё и поболтать с тобой, но беседа и бегство из тюрьмы сумасшедших аурилитов - это два взаимоисключающих занятия, так что..."~
@39792 = ~"Вот он!"~
@39793 = ~"Это они - те, о ком нас предупреждали! Аурил, помоги нам одержать победу... или дай умереть с именем Твоим на устах!"~
@39794 = ~В одной из расщелин ледника мы встретили мужчину, который назвал себя "Мастером замков". Он бежал из тюрьмы в ледяном храме и сказал, что в этой тюрьме сидит некто по имени Натаниэль. Он знает нас и надеется, что мы его спасём.~
@39795 = ~Стихийная форма: элементаль воздуха~
