@19984 = ~Что там ещё?~
@19985 = ~Ох-хо-хо!~
@19986 = ~Я тут.~
@19987 = ~А-ах... ох-хо-хо.~
@19988 = ~Что?~
@19989 = ~Спи спокойно... храбрый товарищ.~
@19990 = ~Тебя не забудут.~
@19991 = ~У-ух.~
@19992 = ~Ладно.~
@19993 = ~Не нравится мне это!~
@19994 = ~Конечно.~
@19995 = ~Мне пора отсюда!~
@19996 = ~Как скажешь~
@19997 = ~Я вас в капусту порублю.~
@19998 = ~Ах-х!~
@19999 = ~Это я запросто.~
@20000 = ~Я этим займусь.~
@20001 = ~Уже иду.~
@20002 = ~Конечно.~
@20003 = ~Что, уже?~
@20004 = ~Тебе это нравится, да?~
@20005 = ~С меня *хватит*.~
@20006 = ~По-моему, ты напрашиваешься.~
@20007 = ~У-х-х!~
@20008 = ~Пара молний - и сразу станет веселей.~
@20009 = ~Уф-ф!~
@20010 = ~Я тебя в землю закопаю!~
@20011 = ~Ух-х.~
@20012 = ~Так, опять.~
@20013 = ~Что-то не так... у нас потери.~
@20014 = ~Мне пора сматываться!~
@20015 = ~Да разорвёт тебя сила!~
@20016 = ~Я больше не могу.~
@20017 = ~Я открою для тебя двери смерти!~
@20018 = ~Надеюсь, из меня выйдет мудрый лидер.~
@20019 = ~Ну давай же.~
@20020 = ~Я буду хорошим лидером.~
@20021 = ~Битва началась!~
@20022 = ~Мне бы отдохнуть как следует.~
@20023 = ~Тебе не победить.~
@20024 = ~Посмотрим, что у тебя есть.~
@20025 = ~Пора отдохнуть, меня надолго не хватит.~
@20026 = ~Стоять здесь вот так - пустая трата моих способностей.~
@20027 = ~Разве нам больше нечем заняться?~
@20028 = ~Думаешь, что сможешь взять меня?~
@20029 = ~Я сделаю всё, что смогу.~
@20030 = ~Я требую, чтобы мне помогли.~
@20031 = ~Тогда вперёд.~
@20032 = ~Мне действительно плохо.~
@20033 = ~Я начинаю уставать.~
@20034 = ~Мне нужен отдых.~
@20035 = ~Что желаешь?~
@20036 = ~Я жду тебя.~
@20037 = ~Моё внимание целиком приковано к тебе.~
@20038 = ~Пойдёмте. Поскучать успеем в могиле.~
@20039 = ~Жду указаний.~
@20040 = ~Меня тяжело ранили.~
@20041 = ~Приказывай.~
@20042 = ~Мои раны... нужно залечить.~
@20043 = ~К твоим услугам.~
@20044 = ~Нужна моя помощь?~
@20045 = ~Да-да, я тут.~
@20046 = ~Жду приказа.~
@20047 = ~К делу.~
@20048 = ~Что?~
@20049 = ~Нельзя войти в режим торговли, когда поблизости враги.~
@20050 = ~Будет сделано.~
@20051 = ~Что прикажешь сделать?~
@20052 = ~Да?~
@20053 = ~Конечно.~
@20054 = ~Хорошо.~
@20055 = ~Что надо сделать?~
@20056 = ~Я жду.~
@20057 = ~Отлично.~
@20058 = ~Отлично.~
@20059 = ~~
@20060 = ~Да, так и сделаю.~
@20061 = ~Я не подведу.~
@20062 = ~Как прикажешь.~
@20063 = ~Определённо.~
@20064 = ~Зачем нам это нужно?~
@20065 = ~Когда пожелаешь.~
@20066 = ~Ты *весьма* меня раздражаешь.~
@20067 = ~Мне не нравится твоя назойливость.~
@20068 = ~А! Ясно.~
@20069 = ~Существо из устройства поддержания жизни~
@20070 = ~Приказ понятен.~
@20071 = ~Существо из устройства поддержания жизни~
@20072 = ~У тебя на этой руке скоро волосы вырастут.~
@20073 = ~Будет сделано. ~
@20074 = ~Да, я знаю... я твой любимый персонаж.~
@20075 = ~Существо из устройства поддержания жизни~
@20076 = ~Это я мигом.~
@20077 = ~Ванмок~
@20078 = ~Существо из устройства поддержания жизни~
@20079 = ~Существо из устройства поддержания жизни~
@20080 = ~Ух!~
@20081 = ~Существо из устройства поддержания жизни~
@20082 = ~Я не понимаю, что ты хочешь этим сказать?~
@20083 = ~А-ах!~
@20084 = ~Ох-о-ох!~
@20085 = ~Я ценю твоё внимание, но давай займёмся делом!~
@20086 = ~Голем-тюремщик~
@20087 = ~Голем-тюремщик~
@20088 = ~М-м-м! Ах-х-х...~
@20089 = ~Теневой Вор~
@20090 = ~Помоги... ух-х...~
@20091 = ~Тебя это, может быть, и забавляет, а вот мне... по душе более конструктивная деятельность.~
@20092 = ~Увы, твой путь окончен, друг.~
@20093 = ~Н-р-р-х!~
@20094 = ~А-а-арх!~
@20095 = ~Какая жалость. С тобой приятно было работать.~
@20096 = ~Не буду оставлять тени без присмотра. Пока!~
@20097 = ~А-а-а!~
@20098 = ~Настало время искать более *тёмные* пастбища.~
@20099 = ~У-ук! У-ух!~
@20100 = ~У-ах-ха!~
@20101 = ~Тихий клинок режет лучше.~
@20102 = ~Держись в тени, друг, и мы выиграем битву.~
@20103 = ~Наш товарищ пал!~
@20104 = ~Поистине наш чёрный день.~
@20105 = ~Быстро и тихо клинок делает своё дело.~
@20106 = ~Нам не победить!~
@20107 = ~Вы рассказали Иллиуму Ар'Гренуару о том, что Гоблика принадлежит к тому клану великанов, который он разгромил, когда основал Андору.~
@20108 = ~Сегодня я не умру!~
@20109 = ~В атаку!~
@20110 = ~Молись своим богам!~
@20111 = ~В бой!~
@20112 = ~Тебя настигнет кара!~
@20113 = ~Вы убили Гоблику по просьбе Иллиума Ар'Гренуара.~
@20114 = ~Ты за всё заплатишь!~
@20115 = ~Вы победили Гоблику по просьбе Иллиума Ар'Гренуара.~
@20116 = ~Эндер Сай~
@20117 = ~Эндер Сай~
@20118 = ~Я покажу пример.~
@20119 = ~Я поведу.~
@20120 = ~Убийство - плохое дело, но победа - хорошее.~
@20121 = ~*зевает* Спа-а-а-ать.~
@20122 = ~Я очищу всё вокруг.~
@20123 = ~В тылу мне нравится больше, но раз ты настаиваешь...~
@20124 = ~В самом деле, нам пора передохнуть.~
@20125 = ~Не стоит тратить время.~
@20126 = ~О, тут стоило бы всё разведать.~
@20127 = ~Чего мы ждём?~
@20128 = ~Найди тихое место для лагеря. Тени зовут меня.~
@20129 = ~Ух-х-х... Нужно исцелить мои раны.~
@20130 = ~Какие глубокие раны...~
@20131 = ~Я здесь.~
@20132 = ~Ты что-то хочешь от меня?~
@20133 = ~Вы убедили Иллиума Ар'Гренуара не нападать на Гоблику.~
@20134 = ~Да?~
@20135 = ~Вы рассказали Иллиуму Ар'Гренуару о великане-вербиге, которого вы увидели.~
@20136 = ~Я с тобой.~
@20137 = ~Кнотт~
@20138 = ~Кнотт~
@20139 = ~По-твоему, я сомнамбула? Мне надо отдохнуть!~
@20140 = ~Чем могу помочь?~
@20141 = ~Где-то там есть спина, которая *дожидается* моего удара.~
@20142 = ~С удовольствием.~
@20143 = ~Понятно.~
@20144 = ~Приступаю.~
@20145 = ~Говори, что делать.~
@20146 = ~Дело непростое.~
@20147 = ~Определённо.~
@20148 = ~Раэмон~
@20149 = ~Раэмон~
@20150 = ~Отлично.~
@20151 = ~Как скажешь~
@20152 = ~Конечно.~
@20153 = ~Я чувствую, это будет *очень* длинный день.~
@20154 = ~Мне вредно терять столько крови!~
@20155 = ~Мне что-то нехорошо.~
@20156 = ~Что ты хочешь на этот раз?~
@20157 = ~Что ж, пойду делать за тебя грязную работу.~
@20158 = ~Я к твоим услугам.~
@20159 = ~Так много дел, так мало времени.~
@20160 = ~Чего желаешь?~
@20161 = ~Жду приказа.~
@20162 = ~Давай.~
@20163 = ~Хватит.~
@20164 = ~Замечательно.~
@20165 = ~*вздыхает* Тупица.~
@20166 = ~Ладно.~
@20167 = ~Ну зачем эти глупые детские шутки?~
@20168 = ~Наверное.~
@20169 = ~Надеюсь, ты получаешь от этого удовольствие.~
@20170 = ~Вы рассказали Иллиуму Ар'Гренуару о том, что Гоблика принадлежит к тому клану великанов, который он разгромил, когда основал Андору.~
@20171 = ~Попробую что-нибудь сделать.~
